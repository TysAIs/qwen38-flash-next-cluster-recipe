# .env — the ONLY three variables the fleet deployer sets. `cp .env.example .env`, edit, run ./start.sh
# (Everything else lives in recipe.yaml — model, KV budget, all engine flags — and cluster.env, which
#  ./setup.sh writes on first run with the probed fabric addresses.)

# 1. Hugging Face READ token. Required: the serving checkpoint (hibrid48-uncensored) is gated —
#    accept its agreement on the model page first. Also readable from `hf auth login`.
HF_TOKEN=

# 2. The second Spark (worker, rank 1) over ssh. Passwordless ssh must work; ./setup.sh installs a key.
WORKER=user@<worker-ip>

# 3. Port the OpenAI-compatible API listens on (head box, host networking).
PORT=8888
